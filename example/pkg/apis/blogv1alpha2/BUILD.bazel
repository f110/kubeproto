load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library", "go_test")
load("//bazel:def.bzl", "kubeproto_go_api")

proto_library(
    name = "blog_proto",
    srcs = ["blog.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "//:k8s_proto",
        "//:kubeproto",
        "//example/proto/github.com/cert-manager/cert-manager/apis/metav1:metav1_proto",
        "@protobuf//:timestamp_proto",
    ],
)

kubeproto_go_api(
    name = "blog_proto_kubeproto",
    srcs = [":blog_proto"],
    importpath = "go.f110.dev/kubeproto/example/pkg/apis/blogv1alpha2",
)

go_library(
    name = "blogv1alpha2",
    srcs = ["blog_proto_kubeproto.generated.object.go"],
    importpath = "go.f110.dev/kubeproto/example/pkg/apis/blogv1alpha2",
    visibility = ["//visibility:public"],
    deps = [
        "//example/proto/github.com/cert-manager/cert-manager/apis/metav1",
        "//go/apis/corev1",
        "//go/apis/metav1",
        "@io_k8s_apimachinery//pkg/runtime",
        "@io_k8s_apimachinery//pkg/runtime/schema",
    ],
)

go_test(
    name = "blogv1alpha2_test",
    srcs = ["test_test.go"],
    embed = [":blogv1alpha2"],
)
